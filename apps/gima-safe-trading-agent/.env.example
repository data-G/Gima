APP_NAME=Gima Safe Trading Agent
APP_ENV=development

POSTGRES_USER=gima
POSTGRES_PASSWORD=gima
POSTGRES_DB=gima_safe_trading
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gima:gima@localhost:5432/gima_safe_trading

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

TRADING_MODE=paper
REAL_TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
REQUIRE_HUMAN_APPROVAL=true
BROKER_BACKEND=mock

ACCOUNT_EQUITY=100000
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_POSITION_CONCENTRATION=0.10
MAX_VOLATILITY=0.06
MIN_CONFIDENCE=0.60
STALE_DATA_SECONDS=300

RUN_MIGRATIONS=true
SEED_DATABASE=true
CREATE_TABLES_ON_STARTUP=false

NOTIFICATIONS_ENABLED=false
WHATSAPP_MODE=mock
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_RECIPIENT=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
